# ==========================================
# ReachInbox Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=5000

# CORS / URLs
# Local: FRONTEND_URL=http://localhost:5173
# Production (Render): Set to your Vercel frontend URL, e.g. https://your-reachinbox.vercel.app (do NOT use trailing slash)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ------------------------------------------
# Database (PostgreSQL - Authoritative Store)
# ------------------------------------------
# Local Docker: postgresql://postgres:password@localhost:5433/reachinbox?schema=public
# Production (Supabase): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@localhost:5433/reachinbox?schema=public

# ------------------------------------------
# Redis & BullMQ
# ------------------------------------------
# Option A - Direct Host & Port (Local Docker):
REDIS_HOST=localhost
REDIS_PORT=6379

# Option B - Redis Connection URL with TLS (Upstash Free Tier / Cloud Redis):
# When REDIS_URL starts with rediss://, TLS is automatically enabled.
# REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@your-endpoint.upstash.io:6379

# ------------------------------------------
# Worker & Rate Limiting
# ------------------------------------------
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
EMAIL_MAX_RETRIES=3

# ------------------------------------------
# Email Delivery Mode (SMTP vs Demo Simulation)
# ------------------------------------------
# Modes:
#   'ethereal'  - Sends via Nodemailer Ethereal SMTP over port 587 (Local/Docker)
#   'simulated' - Demo mode: records simulated delivery without outbound SMTP
#                 (CRITICAL: Required for Render free tier, which blocks ports 25, 465, 587)
EMAIL_DELIVERY_MODE=ethereal

# Ethereal SMTP Settings (used when EMAIL_DELIVERY_MODE=ethereal)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# ------------------------------------------
# Search Engine (Elasticsearch vs PostgreSQL)
# ------------------------------------------
# Set to 'false' for free tier deployments ($0 demo using Supabase PostgreSQL search).
# Set to 'true' if running Elasticsearch in local docker-compose or a managed cluster.
ENABLE_ELASTICSEARCH=false
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------
# OAuth Integrations (Optional)
# ------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# ------------------------------------------
# Security & Encryption (CRITICAL FOR PRODUCTION)
# ------------------------------------------
# In production, ALWAYS generate unique secrets. Never use defaults!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=reachinbox_default_session_secret_key_32_bytes_min
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
