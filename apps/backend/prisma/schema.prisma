datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  googleId         String?           @unique
  name             String
  email            String            @unique
  password         String?
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  senders          Sender[]
  campaigns        Campaign[]
  emails           Email[]
  slackConnections SlackConnection[]

  @@map("users")
}

model Sender {
  id           String   @id @default(uuid())
  userId       String
  email        String
  etherealUser String?
  etherealPass String?
  hourlyLimit  Int      @default(100)
  minDelayMs   Int      @default(2000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       Email[]

  @@map("senders")
}

model Campaign {
  id           String   @id @default(uuid())
  userId       String
  subject      String
  body         String   @db.Text
  startAt      DateTime
  delaySeconds Int      @default(2)
  hourlyLimit  Int      @default(100)
  status       String   @default("scheduled") // scheduled, processing, completed, failed, cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       Email[]

  @@map("campaigns")
}

model Email {
  id                String       @id @default(uuid())
  campaignId        String
  senderId          String
  userId            String
  recipient         String
  subject           String
  body              String       @db.Text
  scheduledAt       DateTime
  sentAt            DateTime?
  status            String       @default("scheduled") // scheduled, processing, sent, failed, cancelled, deferred
  attempts          Int          @default(0)
  providerMessageId String?
  idempotencyKey    String?      @unique
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  campaign          Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender            Sender       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events            EmailEvent[]

  @@index([campaignId, status])
  @@index([senderId, scheduledAt])
  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@map("emails")
}

model Outbox {
  id            String    @id @default(uuid())
  aggregateType String    @default("Email")
  aggregateId   String
  eventType     String    @default("EMAIL_SCHEDULED")
  payload       Json
  status        String    @default("pending") // pending, processing, published, failed
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([status, availableAt])
  @@map("outbox_records")
}

model SlackConnection {
  id                 String   @id @default(uuid())
  userId             String
  teamId             String
  teamName           String
  accessToken        String   // Encrypted at rest
  incomingWebhookUrl String?
  channel            String?
  scope              String
  active             Boolean  @default(true)
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("slack_connections")
}

model EmailEvent {
  id        String   @id @default(uuid())
  emailId   String
  type      String   // email_created, job_scheduled, sending_started, rate_limit_hit, email_deferred, email_sent, email_failed, retry_scheduled
  metadata  Json?
  createdAt DateTime @default(now())

  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@map("email_events")
}
